{
  "name": "gui",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:css": "tailwindcss -i ./styles/tailwind.css -o ./styles/main.css",
    "watch:css": "tailwindcss -i ./styles/tailwind.css -o ./styles/main.css --watch",
    "dev": "npm run build:css && npm run start",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --x64"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "autoprefixer": "^10.4.16",
    "electron": "^27.0.0",
    "postcss": "^8.4.31",
    "postcss-import": "^16.1.1",
    "postcss-nesting": "^13.0.2",
    "tailwindcss": "^3.3.3",
    "electron-builder": "^24.6.0"
  },
  "build": {
    "appId": "com.silhouette.cardmaker",
    "productName": "Silhouette Card Maker",
    "files": [
      "**/*",
      "!node_modules/.cache/**",
      "bin/create_pdf",
      "bin/create_pdf.exe"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "mac": {
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis", "zip"]
    }
  }
}
